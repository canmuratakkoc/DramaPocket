<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Top Return Bar: Visible ONLY during in-app live site browsing -->
    <LinearLayout
        android:id="@+id/liveSiteTopBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentTop="true"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnReturnToApp"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@color/primary"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/return_to_app"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtLiveSiteTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="NartoDrama (Canlı Site)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Main WebView: Local SPA running file:///android_asset/www/index.html with AndroidBridge -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/liveSiteTopBar"
        android:background="@color/background_dark" />

    <!-- Site WebView: Live site player for nartodrama.com (Zero AndroidBridge, sanitized UA) -->
    <WebView
        android:id="@+id/siteWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/liveSiteTopBar"
        android:background="@color/background_dark"
        android:visibility="gone" />

    <!-- Dismissible In-App Popup Overlay Container for ad-gate and external validation -->
    <RelativeLayout
        android:id="@+id/popupContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_dark"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/popupTopBar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentTop="true"
            android:background="@color/surface_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/txtPopupTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/popup_title"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnClosePopup"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@color/accent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/btn_close_popup"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/popupWebViewHolder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/popupTopBar"
            android:background="@color/background_dark" />
    </RelativeLayout>

    <!-- Container for Fullscreen Video Playback (WebChromeClient onShowCustomView) -->
    <FrameLayout
        android:id="@+id/customViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

</RelativeLayout>
